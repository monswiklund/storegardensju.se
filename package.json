{
  "name": "storegardensju.se",
  "private": false,
  "version": "2.1.0",
  "type": "module",
  "homepage": "https://storegardensju.se",
  "scripts": {
    "dev": "bash ./scripts/dev-with-backend.sh",
    "dev:frontend": "vite",
    "dev:backend:up": "../storegardensju-backend/scripts/dev_docker.sh up",
    "dev:backend:logs": "../storegardensju-backend/scripts/dev_docker.sh logs",
    "dev:backend:down": "../storegardensju-backend/scripts/dev_docker.sh down",
    "build": "npm run build:version && vite build && node scripts/generate-route-pages.js",
    "build:version": "node scripts/generate-build-info.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "lucide-react": "^0.454.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/mcp": "^0.0.36",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "6.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.55.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "sharp": "^0.35.3",
    "vite": "^6.2.3",
    "vitest": "^4.0.18"
  }
}

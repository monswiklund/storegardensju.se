# Frontend API URL
# Use localhost backend when not using Access proxy
VITE_API_URL=http://localhost:4242
VITE_FORCE_LOCAL_API=true
VITE_ADMIN_DEV_KEY=dev-admin-key

# Local dev: optional Vite proxy (OFF by default, Cloudflare Access cookies usually work better with direct API URL)
VITE_DEV_USE_ACCESS_PROXY=false
VITE_DEV_PROXY_TARGET=https://api.storegardensju.se
